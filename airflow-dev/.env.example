# =============================================================================
# Apache Airflow 3.x -- Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -- Host UID (WSL2 / Linux) --------------------------------------------------
# Run: echo $(id -u) in your WSL2 terminal and set the value here.
# This ensures files written by Airflow containers are owned by your user.
AIRFLOW_UID=1000

# -- PostgreSQL (running on the HOST, not containerized) ----------------------
# The role and database below must already exist on your host PostgreSQL --
# airflow-init only runs migrations, it does not create them. The host also
# needs listen_addresses / pg_hba.conf configured to allow connections from
# the Docker subnet (see README).
# From inside a container the host is reachable as host.docker.internal on
# Docker Desktop (Mac/Windows) and WSL2; on native Linux compose.yaml maps it
# via extra_hosts. Leave POSTGRES_HOST/PORT as-is unless your host Postgres
# uses a non-default address or port.
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432

# -- Airflow Core -------------------------------------------------------------
# Generate a Fernet key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=

# -- Airflow API --------------------------------------------------------------
# Generate a secret key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Also used by FAB to sign the login session cookie.
AIRFLOW__API__SECRET_KEY=

# Secret/issuer used to sign REST API JWTs. JWT_SECRET has no default --
# compose.yaml refuses to start without it (a guessable secret would let
# anyone on the LAN forge API tokens). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__API_AUTH__JWT_SECRET=
AIRFLOW__API_AUTH__JWT_ISSUER=airflow

# -- Airflow Admin User (FAB auth manager) ------------------------------------
# Users are stored in the metadata DB. airflow-init creates this admin account
# on startup via `airflow users create`; FIRSTNAME/LASTNAME/EMAIL have
# defaults in compose.yaml if left unset here. Manage additional users with
# the `airflow users` CLI or the UI (see README).
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=User
AIRFLOW_ADMIN_EMAIL=admin@example.com
