# Copy this file to .env and adjust the values for your host Postgres.
# docker compose loads .env automatically when running:
#   docker compose -f compose.custom.yaml up -d

# Host Postgres connection settings
# The container connects to host.docker.internal:<POSTGRES_PORT>
POSTGRES_USER=prefect
POSTGRES_PASSWORD=prefect
POSTGRES_PORT=5432
POSTGRES_DB=prefect
